# Конфигурационный файл для TeachAI (образец)
# Скопируйте в .env и заполните ключи. Файл .env в git не коммитить.

# --- Основной TeachAI (OpenAI / совместимый шлюз) ---
OPENAI_API_KEY=your_openai_api_key_here

# Базовая модель генерации (вердикт этапа №5 / бенчмарк 13.09.2026)
LLM_MODEL=gpt-4o-mini

# Режим подключения: direct / vpn / auto / proxy
OPENAI_CONNECTION_MODE=direct

# Прокси только при OPENAI_CONNECTION_MODE=proxy
# OPENAI_PROXY=http://user:pass@host:port

# --- Бенчмарк моделей (Model_Benchmark.ipynb / model_benchmark/) ---
# Нужен только для живого повторного прогона сравнения моделей.
# Для проверки этапа №5 достаточно сохранённых JSON в model_benchmark/results/
# GPTUNNEL_API_KEY=your_gptunnel_api_key_here
