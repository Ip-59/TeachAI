# Конфигурационный файл для TeachAI (образец)
# Скопируйте в .env и заполните ключи. Файл .env в git не коммитить.

# --- Основной TeachAI (OpenAI или шлюз GPTunnel) ---
OPENAI_API_KEY=your_openai_api_key_here

# Базовая модель генерации (вердикт этапа №5 / бенчмарк 13.09.2026)
LLM_MODEL=gpt-4o-mini

# Маршрут API: direct | gptunnel | proxy
# На рабочем ПК с 403 OpenAI geo — gptunnel; дома можно direct.
OPENAI_API_ROUTE=gptunnel
GPTUNNEL_API_KEY=your_gptunnel_api_key_here
# GPTUNNEL_BASE_URL=https://gptunnel.ru/v1

# HTTP-прокси только при OPENAI_API_ROUTE=proxy
# OPENAI_PROXY=http://user:pass@host:port

# --- Бенчмарк моделей (Model_Benchmark.ipynb / model_benchmark/) ---
# Тот же GPTUNNEL_API_KEY используется живым прогоном бенчмарка.
